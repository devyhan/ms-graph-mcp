{
  "name": "@devyhan/ms-graph-mcp",
  "version": "0.1.0",
  "description": "MCP server connecting Microsoft 365 (Outlook, Teams, OneDrive, SharePoint, To Do, Planner, Entra ID, Intune) to AI assistants via Microsoft Graph",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ms-graph-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "pretest": "npm run build",
    "test": "node --test dist/",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "contract": "npm run build && node scripts/graph-contract.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "microsoft-graph",
    "microsoft-365",
    "outlook",
    "teams",
    "sharepoint",
    "entra"
  ],
  "dependencies": {
    "@azure/msal-node": "^6.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  },
  "author": "devyhan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devyhan/ms-graph-mcp.git"
  },
  "homepage": "https://github.com/devyhan/ms-graph-mcp#readme",
  "bugs": {
    "url": "https://github.com/devyhan/ms-graph-mcp/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
